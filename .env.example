# Variables for docker-compose.yml (the NumzLab deployment). Copy to .env on the
# server, fill in real values, chmod 600. Never commit .env.
#
# This is not server/.env.example — that one configures `npm run dev` for local
# backend development and is unrelated to the compose deployment.

# --- Google sign-in ---
# Must equal the Client ID the frontend sends (js/core/store.js
# DEFAULT_GOOGLE_CLIENT_ID unless overridden in the app's Settings), or every
# sign-in fails token verification. A Client ID is a public identifier, not a
# secret. The public URL of this deployment must be listed under "Authorized
# JavaScript origins" for it in Google Cloud Console.
GOOGLE_CLIENT_ID=901733894811-0ra0kkai03vb0rfbuvdgnci8e4n6roj2.apps.googleusercontent.com

# --- Session + Web Push secrets (all four required) ---
# Generate once and keep — rotating the JWT secrets signs everyone out, and
# rotating the VAPID keypair invalidates every device's push subscription.
# `docker compose build` refuses to run until these are set, so build the image
# with plain docker first, then print the four lines to paste below:
#   docker build -t numzstudy .
#   docker run --rm --entrypoint node numzstudy /app/server/scripts/generateSecrets.js
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI push services may use to reach the operator (a mailto: or https:
# URL). Use this deployment's own public URL rather than a personal address.
VAPID_SUBJECT=

# --- Host ports (never 0.0.0.0 — see docker-compose.yml) ---
NUMZSTUDY_HTTP_PORT=8787

# Discovered runtime value, not a constant — regenerate on each server with:
#   docker network inspect bridge --format '{{(index .IPAM.Config 0).Gateway}}'
# This is what host.docker.internal resolves to inside numzlab-platform-gateway.
NUMZSTUDY_GATEWAY_BIND_IP=

# Comma-separated origins allowed to call the API cross-origin. Leave blank:
# the frontend is always served same-origin from this container.
NUMZSTUDY_CORS_ORIGINS=
