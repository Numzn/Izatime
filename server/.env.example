# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://izatime:izatime_dev_pw@localhost:5432/izatime"

# Same OAuth Client ID the frontend uses (js/core/store.js DEFAULT_GOOGLE_CLIENT_ID,
# or whatever a user overrides it to in Settings) — needed here to verify
# that the ID token presented to /auth/google was actually issued for this app.
GOOGLE_CLIENT_ID="901733894811-0ra0kkai03vb0rfbuvdgnci8e4n6roj2.apps.googleusercontent.com"

# Secrets for signing our own JWTs. Generate real ones for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"

# VAPID keypair for Web Push. Generate with: npm run vapid:generate
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

PORT=8787

# Comma-separated list of origins allowed to call this API (your deployed
# app's URL(s), plus http://localhost:PORT while developing locally).
CORS_ORIGINS="http://localhost:8080,http://127.0.0.1:8080"
